{
  "name": "cli-agent",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cli-agent": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "test": "vitest run tests/",
    "test:unit": "vitest run tests/tools tests/core tests/errors",
    "test:llm": "vitest run tests/integration/llm-tools.test.ts --reporter=verbose",
    "test:llm:watch": "vitest tests/integration/llm-tools.test.ts --reporter=verbose"
  },
  "dependencies": {
    "@ai-sdk/groq": "^1.2.9",
    "@ai-sdk/openai": "^1.3.22",
    "ai": "^4.3.16",
    "chalk": "^4.1.2",
    "cheerio": "^1.2.0",
    "cli-highlight": "^2.1.11",
    "diff": "^9.0.0",
    "dotenv": "^16.4.7",
    "execa": "^5.1.1",
    "fast-glob": "^3.3.3",
    "fuse.js": "^7.4.2",
    "ignore": "^7.0.5",
    "ink": "^4.4.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "react": "^18.3.1",
    "turndown": "^7.2.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.1",
    "@types/turndown": "^5.0.6",
    "tsup": "^8.4.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
