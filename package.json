{
  "name": "cli-agent",
  "version": "1.0.0",
  "description": "CLI coding agent with multi-provider LLM support",
  "main": "dist/index.js",
  "bin": {
    "cli-agent": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts",
