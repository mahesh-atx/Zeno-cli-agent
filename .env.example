# .env.example — copy to .env and fill in your keys

# API Keys (add at least one)
OPENROUTER_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENCODEZEN_API_KEY=

# Provider Settings
DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=openai/gpt-4o-mini

# Model Settings
TEMPERATURE=0.7
MAX_TOKENS=16384

# Security (optional)
# Allow tools to write outside project root (default false)
# ALLOW_OUTSIDE_CWD=0
# Allow web_fetch to access private networks (default false)
# ALLOW_PRIVATE_NETWORK=0
